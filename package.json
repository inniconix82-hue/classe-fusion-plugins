{
  "name": "node-organization-app",
  "version": "1.0.0",
  "description": "Application d'organisation visuelle par nodes connectables",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:build": "npm run build && electron-builder",
    "electron:build:win": "npm run build && electron-builder --win",
    "package:win": "npm run build && npx @electron/packager . \"Node Organisation\" --platform=win32 --arch=x64 --out=release --overwrite --ignore=\"node_modules|src|public|electron|vite\\.config|tsconfig|build-windows\" --app-version=1.0.0",
    "package:mac": "npm run build && npx @electron/packager . \"Node Organisation\" --platform=darwin --arch=x64,arm64 --out=release --overwrite --ignore=\"^/src\" --ignore=\"^/public\" --ignore=\"^/electron\" --ignore=\"^/\\.git\" --ignore=\"\\.ts$\" --ignore=\"\\.bat$\" --ignore=\"^/vite\" --ignore=\"^/tsconfig\" --ignore=\"^/release\" --app-version=1.0.0",
    "build:web": "tsc && vite build --config vite.web.config.ts",
    "preview:web": "vite preview --config vite.web.config.ts"
  },
  "build": {
    "appId": "com.nodesorg.app",
    "productName": "Node Organisation",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/icon.png",
      "sign": false,
      "signingHashAlgorithms": null
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "installerLanguages": [
        "fr"
      ],
      "language": "1036"
    }
  },
  "dependencies": {
    "@dagrejs/dagre": "^1.1.0",
    "@xyflow/react": "^12.0.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^2.5.2",
    "pdfjs-dist": "^5.6.205",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@electron/packager": "^18.3.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^8.2.0",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "vite-plugin-electron": "^0.28.0",
    "vite-plugin-electron-renderer": "^0.14.0",
    "wait-on": "^7.2.0"
  }
}
